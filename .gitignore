node_modules/
*.log
.DS_Store
.env
.env.*
!.env.example
.vscode/
.idea/

# Eval harness runtime output (per-run results; baseline.json is committed)
test/eval/last-run.json

# Project-personal Claude Code settings (machine-specific permission rules)
.claude/settings.local.json

# Claude Code agent worktrees — transient per-agent isolated checkouts created
# by the Agent tool's worktree isolation; never part of the repo.
.claude/worktrees/

# Architect directive staging files (temp content for DB row filing)
.architect-row/

# Benchmark output (local runs only)
scripts/bench-results.csv

# --- Local session scratch & private-tooling-referencing artifacts (NEVER commit) ---
# Root-anchored on purpose: these patterns must not shadow tracked schema/findings files
# (scripts/setup.sql, scripts/sql/*.sql, docs/findings/debate-*.md, start-vllm-reranker.sh).
# Covers: handoff/debate/as-is scratch notes, root-level SQL/CSV dumps, vLLM launch
# scripts, and hook log spew — these reference private orchestration tooling and/or
# contain local DB data, and may never enter the public repo.
/HANDOFF-*.md
/DEBATE-*.md
/AS-IS-*.md
/NATE-JONES-*.md
/*.sql
/*.csv
/loader_hook_*.txt
/launch-vllm-bg.sh
/start-vllm.sh
/vllm-*.err
scripts/_apply_schema.js
scripts/decisions_backup*.csv
.playwright-mcp/
.claude/scheduled_tasks.lock
/BUNDLE-A-SPEC.md
/social-posts.md

# Local consolidation/planning docs that reference private infrastructure
# (private DB names, personal filesystem paths, private project names,
# private orchestration tooling) — never distributed with the public repo.
/CONSOLIDATION-RUNBOOK.md
/RUNBOOK-INDEX.md
/START-HERE-CONSOLIDATION.md
/FIELD-REPORT-*.md

# §15 acceptance-battery roster + fixture files carry private estate data
# (real source DB names, real filesystem paths, real project queries) — the
# committed *.example.json files document the required shape; these two
# stay local only. See scripts/migrations/lib/verify15-shared.js loadRoster().
/scripts/migrations/source-table-roster.json
/scripts/migrations/recall-equivalence-queries.json

# migrate-02-decisions.js's routing map — real project identifiers +
# private per-project routing rules (CONSOLIDATION-RUNBOOK.md §16.1/§16.2),
# never committed. scripts/migrations/topic-prefix-to-project.example.json
# documents the required shape. See migrate-02-decisions.js's
# loadRoutingMap().
/scripts/migrations/topic-prefix-to-project.json

# migrate-02-decisions.js's pre-migration source backup dumps — real
# claude_policy_framework.decisions content (private, cross-project prose),
# never committed. See migrate-02-decisions.js's backupSourceTable().
/scripts/migrations/backups/

# migrate-03-corpus-project-id.js's built project-attribution map — an
# AUDIT ARTIFACT of each run (never read back as input, D3-7), carrying
# real ~/.claude/projects directory names, real database names, and real
# project marker UUIDs. Never committed.
# scripts/migrations/memory-entry-project-map.example.json documents the
# shape. See migrate-03-corpus-project-id.js's writeMapArtifact().
/scripts/migrations/memory-entry-project-map.json

# migrate-08-handoff-markdown.js's per-project fail-soft parse reports —
# may embed real HANDOFF.md/HANDOFF-HISTORY.md content (subjects, session
# summaries), never committed. See migrate-08-handoff-markdown.js's
# writeReport().
/scripts/migrations/reports/
