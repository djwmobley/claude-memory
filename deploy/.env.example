# deploy/.env.example -- copy to deploy/.env and fill in real values.
# deploy/.env is gitignored; never commit real secrets into this repo.
#
# Normally you never hand-edit this file: the installer
# (scripts/install.js, see docs/specs/package-and-installer.md section 5)
# generates POSTGRES_PASSWORD and writes deploy/.env for you the first time
# it provisions Postgres via docker-compose.yml. Every variable
# deploy/docker-compose.yml reads is documented here with its default and
# purpose, for anyone who wants to run compose by hand instead.

# --- Postgres (always on) ---------------------------------------------------

# Postgres superuser name inside the container. Rarely needs changing.
POSTGRES_USER=postgres

# REQUIRED -- no default. Generated by the installer: random,
# alphanumeric-only (no characters that need shell-quoting), at least 32
# characters long. Never a hardcoded/default value -- docker-compose.yml
# refuses to start the postgres service if this is unset. If you are
# filling this in by hand, generate your own random 32+ character
# alphanumeric string; do not reuse any example value.
POSTGRES_PASSWORD=

# Database name created inside the container on first init.
POSTGRES_DB=claude_memory

# Host-side port Postgres is published on, bound to 127.0.0.1 only. Change
# this if 5432 is already in use locally -- the container's own internal
# port always stays 5432.
MM_PG_PORT=5432

# Set by the installer (never by hand) when IT provisioned Postgres via
# this compose file, as opposed to an external/pre-existing Postgres the
# prerequisite check resolved instead. Used to gate `--purge-data`: an
# externally-provisioned Postgres is never dropped by this project's own
# uninstall path, only a compose-provisioned one. Value convention:
# MM_PG_PROVISIONED=compose
MM_PG_PROVISIONED=

# --- Embedder (optional, OFF by default) ------------------------------------
# Only read when you explicitly enable the `embedder` compose profile:
#   docker compose --profile embedder up -d embedder
# Leave these commented out if you don't have a local GPU or vLLM isn't
# part of your setup -- search degrades to full-text-search-only ranking
# without an embedder (see docs/hosts/codex.md's degraded-modes note).

# vLLM-compatible OpenAI-API-server image.
#MM_EMBEDDER_IMAGE=vllm/vllm-openai:latest

# Embedding model vLLM serves.
#MM_EMBEDDER_MODEL=Qwen/Qwen3-Embedding-8B

# Host-side port the embedder's OpenAI-compatible API is published on,
# bound to 127.0.0.1 only.
#MM_EMBEDDER_PORT=8000
