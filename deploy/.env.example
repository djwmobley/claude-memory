# deploy/.env.example -- copy to deploy/.env and fill in real values.
# deploy/.env is gitignored; never commit real secrets into this repo.
#
# Today, this file is filled in by hand: copy it to deploy/.env and set
# POSTGRES_PASSWORD yourself (see the comment on that variable below).
#
# Planned, not yet shipped (docs/specs/package-and-installer.md section 5,
# in progress in a parallel PR): scripts/install.js will generate
# POSTGRES_PASSWORD and write deploy/.env for you automatically the first
# time it provisions Postgres via docker-compose.yml, so you would no
# longer normally hand-edit this file. Until that lands, every variable
# deploy/docker-compose.yml reads is documented here with its purpose and
# default, for filling in and running compose by hand.

# --- Postgres (always on) ---------------------------------------------------

# Postgres superuser name inside the container. Rarely needs changing.
POSTGRES_USER=postgres

# REQUIRED -- no default, and never a hardcoded/default value --
# docker-compose.yml refuses to start the postgres service if this is
# unset. Fill this in by hand today: generate your own random,
# alphanumeric-only (no characters that need shell-quoting) string of at
# least 32 characters; do not reuse any example value.
#
# Planned, not yet shipped: once scripts/install.js's automatic
# provisioning lands (see the file header above), it will generate this
# value for you instead.
POSTGRES_PASSWORD=

# Database name created inside the container on first init.
POSTGRES_DB=claude_memory

# Host-side port Postgres is published on, bound to 127.0.0.1 only. Change
# this if 5432 is already in use locally -- the container's own internal
# port always stays 5432.
MM_PG_PORT=5432

# Planned, not yet shipped: once scripts/install.js's automatic
# provisioning lands (see the file header above), it will set this itself
# (never by hand) when IT provisioned Postgres via this compose file, as
# opposed to an external/pre-existing Postgres the prerequisite check
# resolved instead -- used to gate a future `--purge-data`, so an
# externally-provisioned Postgres is never dropped by this project's own
# uninstall path, only a compose-provisioned one. Value convention once
# implemented: MM_PG_PROVISIONED=compose. Leave unset until that lands.
MM_PG_PROVISIONED=

# --- Embedder (optional, OFF by default) ------------------------------------
# Only read when you explicitly enable the `embedder` compose profile:
#   docker compose --profile embedder up -d embedder
# Leave these commented out if you don't have a local GPU or vLLM isn't
# part of your setup -- search degrades to full-text-search-only ranking
# without an embedder (see docs/hosts/codex.md's degraded-modes note).

# vLLM-compatible OpenAI-API-server image.
#MM_EMBEDDER_IMAGE=vllm/vllm-openai:latest

# Embedding model vLLM serves.
#MM_EMBEDDER_MODEL=Qwen/Qwen3-Embedding-8B

# Host-side port the embedder's OpenAI-compatible API is published on,
# bound to 127.0.0.1 only.
#MM_EMBEDDER_PORT=8000
